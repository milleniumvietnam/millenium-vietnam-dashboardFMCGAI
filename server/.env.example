# MILLENNIUM VIETNAM - ENVIRONMENT CONFIGURATION

# Server Config
PORT=3000

# Google Gemini API Configuration
# Đăng ký lấy Gemini API Key miễn phí / bản Enterprise tại Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here

# n8n Configuration
N8N_API_URL=http://localhost:5678
N8N_API_KEY=your-n8n-api-key-here
BACKEND_CALLBACK_URL=http://localhost:3000/api/n8n/callback
